################################################################################
# CloudWatch log groups (created before the instance so Docker / the CloudWatch
# agent / SSM never auto-create them without a retention period).
################################################################################

resource "aws_cloudwatch_log_group" "this" {
  for_each = toset(["backend", "nginx", "mongo", "system", "ssm"])

  name              = "${var.log_group_prefix}/${each.key}"
  retention_in_days = var.log_retention_days
}

locals {
  log_group_names = { for key, group in aws_cloudwatch_log_group.this : key => group.name }
}

################################################################################
# Artifacts bucket
#   deploy/   files the server downloads at boot and on every deployment
#   backups/  MongoDB backups, expired after backup_retention_days
################################################################################

resource "aws_s3_bucket" "artifacts" {
  bucket = "${var.name}-artifacts-${var.account_id}"

  # Lets `npm run destroy` delete the bucket together with its backups.
  force_destroy = true
}

resource "aws_s3_bucket_public_access_block" "artifacts" {
  bucket = aws_s3_bucket.artifacts.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_ownership_controls" "artifacts" {
  bucket = aws_s3_bucket.artifacts.id

  rule {
    object_ownership = "BucketOwnerEnforced"
  }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "artifacts" {
  bucket = aws_s3_bucket.artifacts.id

  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

resource "aws_s3_bucket_versioning" "artifacts" {
  bucket = aws_s3_bucket.artifacts.id

  versioning_configuration {
    status = "Enabled"
  }
}

resource "aws_s3_bucket_lifecycle_configuration" "artifacts" {
  bucket = aws_s3_bucket.artifacts.id

  rule {
    id     = "expire-backups"
    status = "Enabled"

    filter {
      prefix = "backups/"
    }

    expiration {
      days = var.backup_retention_days
    }

    noncurrent_version_expiration {
      noncurrent_days = 1
    }

    abort_incomplete_multipart_upload {
      days_after_initiation = 1
    }
  }

  rule {
    id     = "expire-old-deploy-file-versions"
    status = "Enabled"

    filter {
      prefix = "deploy/"
    }

    noncurrent_version_expiration {
      noncurrent_days = 30
    }
  }

  depends_on = [aws_s3_bucket_versioning.artifacts]
}

data "aws_iam_policy_document" "artifacts" {
  statement {
    sid       = "DenyInsecureTransport"
    effect    = "Deny"
    actions   = ["s3:*"]
    resources = [aws_s3_bucket.artifacts.arn, "${aws_s3_bucket.artifacts.arn}/*"]

    principals {
      type        = "*"
      identifiers = ["*"]
    }

    condition {
      test     = "Bool"
      variable = "aws:SecureTransport"
      values   = ["false"]
    }
  }
}

resource "aws_s3_bucket_policy" "artifacts" {
  bucket = aws_s3_bucket.artifacts.id
  policy = data.aws_iam_policy_document.artifacts.json

  depends_on = [aws_s3_bucket_public_access_block.artifacts]
}

################################################################################
# Files the server runs (infra/modules/app-server/files/** -> s3://.../deploy/**).
# Line endings are normalised so files edited on Windows still run on Linux.
################################################################################

locals {
  deploy_files_dir = "${path.module}/files"
}

resource "aws_s3_object" "deploy_files" {
  for_each = fileset(local.deploy_files_dir, "**")

  bucket       = aws_s3_bucket.artifacts.id
  key          = "deploy/${each.value}"
  content      = replace(file("${local.deploy_files_dir}/${each.value}"), "\r\n", "\n")
  content_type = "text/plain; charset=utf-8"
}

# Non-secret settings for the server scripts and for docker compose interpolation.
# Secrets are NOT here - the server reads them from SSM Parameter Store.
resource "aws_s3_object" "settings" {
  bucket       = aws_s3_bucket.artifacts.id
  key          = "deploy/settings.env"
  content_type = "text/plain; charset=utf-8"
  content      = <<-EOT
    # Generated by Terraform (infra/modules/app-server/storage.tf). Do not edit on the server:
    # change infra/environments/<env>.tfvars and deploy again.
    PROJECT_NAME="${var.project_name}"
    ENVIRONMENT="${var.environment}"
    APP_NAME="${var.name}"
    AWS_REGION="${var.aws_region}"
    AWS_DEFAULT_REGION="${var.aws_region}"
    ARTIFACTS_BUCKET="${aws_s3_bucket.artifacts.id}"
    SSM_PREFIX="${var.ssm_prefix}"
    ECR_REPOSITORY_URL="${var.ecr_repository_url}"
    ECR_REGISTRY="${split("/", var.ecr_repository_url)[0]}"
    DB_MODE="${var.database_mode}"
    APP_PORT="${var.app_port}"
    HEALTH_CHECK_PATH="${var.health_check_path}"
    CLIENT_MAX_BODY_SIZE="${var.client_max_body_size}"
    NGINX_IMAGE="${var.nginx_image}"
    MONGO_IMAGE="${var.mongo_image}"
    MONGO_CACHE_SIZE_GB="${var.mongo_cache_size_gb}"
    MONGO_DATABASE="${var.mongo_database_name}"
    MONGO_ROOT_USERNAME="${var.mongo_root_username}"
    MONGO_APP_USERNAME="${var.mongo_app_username}"
    DATA_VOLUME_ID="${local.local_db ? aws_ebs_volume.data[0].id : ""}"
    SWAP_SIZE_MB="${var.swap_size_mb}"
    COMPOSE_VERSION="${var.docker_compose_version}"
    BACKUP_SCHEDULE="${var.backup_schedule}"
    BACKUP_PREFIX="backups/mongo"
    METRIC_NAMESPACE="${var.metric_namespace}"
    LOG_GROUP_BACKEND="${local.log_group_names.backend}"
    LOG_GROUP_NGINX="${local.log_group_names.nginx}"
    LOG_GROUP_MONGO="${local.log_group_names.mongo}"
  EOT
}

# CloudWatch agent: memory / swap / disk metrics (not collected by EC2 by default)
# plus the server's own log files.
resource "aws_s3_object" "cloudwatch_agent_config" {
  bucket       = aws_s3_bucket.artifacts.id
  key          = "deploy/cloudwatch-agent.json"
  content_type = "application/json"
  content = jsonencode({
    agent = {
      metrics_collection_interval = 60
      run_as_user                 = "root"
    }
    metrics = {
      namespace         = "CWAgent"
      append_dimensions = { InstanceId = "$${aws:InstanceId}" }
      metrics_collected = {
        mem  = { measurement = ["mem_used_percent"] }
        swap = { measurement = ["swap_used_percent"] }
        disk = {
          measurement = ["used_percent"]
          resources   = local.local_db ? ["/", "/data"] : ["/"]
          drop_device = true
        }
      }
    }
    logs = {
      logs_collected = {
        files = {
          collect_list = [
            for f in local.server_log_files : {
              file_path       = f.path
              log_group_name  = local.log_group_names.system
              log_stream_name = "{instance_id}/${f.stream}"
            }
          ]
        }
      }
    }
  })
}

locals {
  # Server log files shipped to the "system" log group, one stream per file.
  server_log_files = [
    { path = "/var/log/app/bootstrap.log", stream = "bootstrap" },
    { path = "/var/log/app/deploy.log", stream = "deploy" },
    { path = "/var/log/app/backup.log", stream = "backup" },
    { path = "/var/log/cloud-init-output.log", stream = "cloud-init" },
  ]
}
